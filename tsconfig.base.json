{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cube-arcade/game-sdk": ["packages/game-sdk/src/index.ts"],
      "@cube-arcade/game-engine": ["packages/game-engine/src/index.ts"],
      "@cube-arcade/smartcube": ["packages/smartcube/src/index.ts"],
      "@cube-arcade/testing": ["packages/testing/src/index.ts"],
      "@cube-arcade/ui": ["packages/ui/src/index.ts"]
    }
  }
}
